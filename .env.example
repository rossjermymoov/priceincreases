# RateShift Configuration for Railway & Local

# HTTP Port
PORT=3000

# PostgreSQL Database Connection String
# On Railway, this is automatically injected when you attach a PostgreSQL database service.
# If omitted locally, the app seamlessly defaults to SQLite (data/rateshift.db).
DATABASE_URL=

# Despatch Cloud Billing API
BILLING_API_BASE=https://production.billingapi.co.uk
BILLING_API_TOKEN=iiMcRFucDESz3pxU

# Default Scheduled Execution Date (UTC)
SCHEDULE_DATE=2027-01-01T00:01:00Z
